+
+/** SEC: HP Scanjet 3770 ---------- */
+
+static SANE_Int hp3770_timing_get(SANE_Int sensortype, SANE_Int tm, struct st_timing *reg)
+{
+	/* timing tables of the original 3770 driver (t6_TimingN, index =
+	   TimingN - 1). The 3770 driver always uses the t6 profile, whatever
+	   the CCD detection reports. */
+	SANE_Int rst = ERROR;
+
+	(void) sensortype;
+
+	if ((reg != NULL) && (tm >= 0) && (tm < 12))
+	{
+		memcpy(reg, &hp3770_timing[tm], sizeof(struct st_timing));
+		rst = OK;
+	}
+
+	return rst;
+}
+
+static SANE_Int *hp3770_motor()
+{
+	SANE_Int *rst = (SANE_Int *)malloc(sizeof(hp3770_motorcurves));
+
+	if (rst != NULL)
+		memcpy(rst, hp3770_motorcurves, sizeof(hp3770_motorcurves));
+
+	return rst;
+}
+
+static SANE_Int hp3770_checkstable(SANE_Int lamp, struct st_checkstable *check)
+{
+	SANE_Int rst = ERROR;
+
+	if (check != NULL)
+	{
+		const struct st_checkstable *value = NULL;
+
+		switch (lamp)
+		{
+			case 0: value = &hp3770_checkstable_preview; break;
+			case FLB_LAMP: value = &hp3770_checkstable_flb; break;
+			case TMA_LAMP: value = &hp3770_checkstable_tma; break;
+		}
+
+		if (value != NULL)
+		{
+			memcpy(check, value, sizeof(struct st_checkstable));
+			rst = OK;
+		}
+	}
+
+	return rst;
+}
+
+static int hp3770_calibreflective_get(int option, int defvalue)
+{
+	/* HP3770_HP3970_CALIBRATION=1 selects the HP3970 starting values instead
+	   of the 3770 driver ones (troubleshooting aid) */
+	const char *fallback = getenv("HP3770_HP3970_CALIBRATION");
+
+	if ((fallback != NULL) && (fallback[0] == '1'))
+		return hp3970_calibreflective(option, defvalue);
+
+	return hp3770_calibreflective(option, defvalue);
+}
+
+static void hp3770_shading_cut(SANE_Int sensortype, SANE_Int depth, SANE_Int res, SANE_Int scantype, SANE_Int *red, SANE_Int *green, SANE_Int *blue)
+{
+	/* reflective Toshiba/USB2 values come from the 3770 driver; everything
+	   else (transparency, negative, Sony, USB 1.1) keeps the HP3970 table */
+	hp3970_shading_cut(RTS_Debug->usbtype, sensortype, depth, res, scantype, red, green, blue);
+
+	if ((scantype == ST_NORMAL) && (sensortype == CCD_SENSOR) && (RTS_Debug->usbtype == USB20))
+	{
+		SANE_Int a, count = sizeof(hp3770_reflective_cut) / sizeof(hp3770_reflective_cut[0]);
+		SANE_Int myres;
+
+		if (res <= 100) myres = 100;
+		else if (res <= 200) myres = 200;
+		else if (res <= 300) myres = 300;
+		else if (res <= 600) myres = 600;
+		else if (res <= 1200) myres = 1200;
+		else myres = 2400;
+
+		for (a = 0; a < count; a++)
+		{
+			if ((hp3770_reflective_cut[a].depth == ((depth > 8) ? 16 : 8)) && (hp3770_reflective_cut[a].res == myres))
+			{
+				*red   = hp3770_reflective_cut[a].cut[CL_RED];
+				*green = hp3770_reflective_cut[a].cut[CL_GREEN];
+				*blue  = hp3770_reflective_cut[a].cut[CL_BLUE];
+				break;
+			}
+		}
+	}
+}
+
+static SANE_Int hp3770_gainoffset(SANE_Int sensortype, struct st_gain_offset *myreg)
+{
+	/* hp3970_gainoffset() never matches (its loop tests "count < 4" with
+	   count == 4), so the HP3970 path leaves every default at zero. With
+	   calibration disabled the final scan then runs at PAG 0 while the
+	   software white shading was measured at PAG 3, which makes images about
+	   four times too dark (first 3770 hardware scan). Use the 3770 driver's
+	   defaults instead. */
+	(void) sensortype;
+
+	if (myreg == NULL)
+		return ERROR;
+
+	memcpy(myreg, &hp3770_gain_offset, sizeof(struct st_gain_offset));
+	return OK;
+}
+
+static void hp3770_vrefs_get(SANE_Int res, SANE_Int *ser, SANE_Int *ler)
+{
+	/* [SCAN_PARAM] SER_n/LER_n of the t6 profile */
+	SANE_Int a, count = sizeof(hp3770_vrefs) / sizeof(hp3770_vrefs[0]);
+
+	if ((ser == NULL) || (ler == NULL))
+		return;
+
+	*ser = *ler = 0;
+	for (a = 0; a < count; a++)
+		if (hp3770_vrefs[a][0] == res)
+		{
+			*ser = hp3770_vrefs[a][1];
+			*ler = hp3770_vrefs[a][2];
+			break;
+		}
+}
+
+static SANE_Int hp3770_motormove_get(SANE_Int item, struct st_motormove *reg)
+{
+	SANE_Int count = sizeof(hp3770_motormoves) / sizeof(hp3770_motormoves[0]);
+
+	if ((reg == NULL) || (item < 0) || (item >= count))
+		return ERROR;
+
+	memcpy(reg, &hp3770_motormoves[item], sizeof(struct st_motormove));
+	return OK;
+}
+
+static SANE_Int hp3770_scanmodes_get(SANE_Int usb, SANE_Int sm, struct st_scanmode *mymode)
+{
+	/* the 3770 driver only has USB 2 reflective modes; the same table is
+	   used on a USB 1.1 port */
+	SANE_Int count = sizeof(hp3770_scanmodes) / sizeof(hp3770_scanmodes[0]);
+
+	(void) usb;
+
+	if ((mymode == NULL) || (sm < 0) || (sm >= count))
+		return ERROR;
+
+	memcpy(mymode, &hp3770_scanmodes[sm], sizeof(struct st_scanmode));
+	return OK;
+}
+
+static int srt_hp3770_platform_get(int option, int defvalue)
+{
+	switch (option)
+	{
+		case BINARYTHRESHOLDH: return HP3770_BINARY_THRESHOLD_H;
+		case BINARYTHRESHOLDL: return HP3770_BINARY_THRESHOLD_L;
