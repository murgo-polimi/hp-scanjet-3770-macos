+/* HP3770 transport notes (from the original HP 3770 driver,
+   CChipDriver::USBVendorRequest / USBExecCommand):
+   - every vendor request uses bRequest = 0x00; the command code lives in the
+     high byte of wIndex (0x01 register read, 0x00 register write, 0x02 NVRAM,
+     0x04 DMA, 0x08 DMA reset), exactly the wIndex values hp3900 already uses.
+     hp3900 sends bRequest = 0x04 for the HP3970. HP3770_USB_REQUEST=0x04
+     reproduces that behaviour.
+   - register/NVRAM writes are split into 64-byte transfers at increasing
+     addresses. HP3770_USB_WRITE_CHUNK=0 disables the split. */
+
+#define HP3770_WRITE_CHUNK 0x40
+
+static SANE_Int
+usb_vendor_request (void)
+{
+  static SANE_Int request = -1;
+
+  if (request < 0)
+    {
+      const char *env = getenv ("HP3770_USB_REQUEST");
+      request = (env != NULL) ? (SANE_Int) (strtol (env, NULL, 0) & 0xff) : 0x00;
+      DBG (DBG_VRB, " -> USB vendor bRequest = 0x%02x\n", request);
+    }
+
+  return request;
+}
+
+static SANE_Int
+usb_write_chunk (void)
+{
+  static SANE_Int chunk = -1;
+
+  if (chunk < 0)
+    {
+      const char *env = getenv ("HP3770_USB_WRITE_CHUNK");
+      chunk = (env != NULL) ? (SANE_Int) strtol (env, NULL, 0) : HP3770_WRITE_CHUNK;
+      if (chunk < 0)
+	chunk = HP3770_WRITE_CHUNK;
+    }
+
+  return chunk;
+}
